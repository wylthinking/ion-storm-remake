{
  "name": "ion-storm-web-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run ai:weights:sync && npm run custom:json:sync && vite --host 0.0.0.0",
    "server": "tsx src/server/server.ts",
    "build": "npm run ai:weights:sync && npm run custom:json:sync && tsc && vite build && tsc -p tsconfig.server.json",
    "worker:build": "npm run build && tsc -p tsconfig.worker.json",
    "worker:demo": "npm run worker:build && wrangler dev",
    "worker:deploy": "npm run worker:build && wrangler deploy",
    "start": "node dist/server/server.js",
    "ai:weights:sync": "tsx scripts/sync-advanced-ai-weights.ts",
    "custom:json:sync": "tsx scripts/sync-custom-json.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "redis": "^4.7.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.1",
    "wrangler": "^4.120.0"
  },
  "engines": {
    "node": ">=20"
  }
}
